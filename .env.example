# Environment Configuration Template for User Portal
# Copy this file to .env and update values for your environment
# This file CAN be committed to version control as it contains only template values

# ============================================
# API Configuration
# ============================================
# Base URL for API requests
VITE_API_BASE_URL=http://localhost:3000/api

# API version
VITE_API_VERSION=v1

# API request timeout in milliseconds
VITE_API_TIMEOUT=10000

# API retry configuration
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000

# ============================================
# Application Configuration
# ============================================
# Application name
VITE_APP_NAME=User Portal

# Log API requests (true/false)
VITE_LOG_API_REQUESTS=false

# ============================================
# Storage Configuration
# ============================================
# Local storage keys
VITE_STORAGE_TOKEN_KEY=auth_token
VITE_STORAGE_REFRESH_TOKEN_KEY=refresh_token
VITE_STORAGE_USER_KEY=user_data

# Session timeout in milliseconds (default: 1 hour = 3600000)
VITE_SESSION_TIMEOUT=3600000

# ============================================
# Pagination Configuration
# ============================================
# Default items per page
VITE_DEFAULT_PAGE_SIZE=10

# ============================================
# Logging Configuration
# ============================================
# Log level: debug | info | warn | error
VITE_LOG_LEVEL=info
